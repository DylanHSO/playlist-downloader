{
  "name": "youtube-playlist-downloader",
  "version": "0.1.0",
  "description": "Zoek YouTube-nummers op en download ze als MP3",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "electron:dev": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "archiver": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "yt-dlp-exec": "^1.0.2",
    "yt-search": "^2.10.4"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.dylanhso.playlistdownloader",
    "productName": "Playlist Downloader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "server.js",
      "public/**",
      "node_modules/**"
    ],
    "asarUnpack": [
      "node_modules/yt-dlp-exec/bin/**",
      "node_modules/@ffmpeg-installer/**"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Playlist Downloader"
    }
  }
}
