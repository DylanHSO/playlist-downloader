{
  "name": "youtube-playlist-downloader",
  "version": "0.3.0",
  "description": "Zoek YouTube-nummers op en download ze als MP3",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "predev": "node scripts/predev.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "start": "npm run build && node dist/server/index.js",
    "electron:dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "archiver": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "node-id3": "^0.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "yt-dlp-exec": "^1.0.2",
    "yt-search": "^2.10.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.dylanhso.playlistdownloader",
    "productName": "Playlist Downloader",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "node_modules/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/yt-dlp-exec/bin/**",
      "node_modules/@ffmpeg-installer/**"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Playlist Downloader"
    }
  }
}
